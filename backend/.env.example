NODE_ENV=development
PORT=5000

# Local: mongodb://localhost:27017/ecommerce
# Production: mongodb+srv://<user>:<password>@<cluster>/ecommerce
MONGO_URI=mongodb://localhost:27017/ecommerce
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h

# Required only when running production seed scripts.
SEED_CUSTOMER_PASSWORD=replace-with-a-private-demo-password
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@techecommerce.vn
ADMIN_PASSWORD=replace-with-a-private-admin-password

# Optional locally. Vercel provides its deployment URL automatically.
APP_BASE_URL=http://localhost:5000
FRONTEND_BASE_URL=http://localhost:5000

# Use mock for a graduation demo without gateway credentials.
PAYMENT_GATEWAY_MODE=mock

# Email xác nhận đơn hàng. Với Gmail, bật xác minh 2 bước và dùng App Password 16 ký tự.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=TechEcommerce
EMAIL_FROM=
FRONTEND_BASE_URL=
ORDER_NOTIFICATION_EMAIL=banphan272004@gmail.com

# Khôi phục mật khẩu qua SMS OTP bằng Twilio Verify.
# Tài khoản Trial chỉ gửi được tới số điện thoại đã xác minh trong Twilio Console.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_VERIFY_SERVICE_SID=
# Để trống để Twilio tự chọn ngôn ngữ theo số điện thoại.
TWILIO_VERIFY_LOCALE=

# Tài khoản nhận chuyển khoản thủ công. QR là tùy chọn, không bắt buộc.
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=
BANK_NAME=
BANK_TRANSFER_DEMO=false
# Dùng một trong hai biến dưới. IMAGE_URL dành cho ảnh QR tĩnh; PAYLOAD dành cho
# chuỗi QR chuẩn do ngân hàng cung cấp và hỗ trợ {amount}, {reference}, {accountNo}.
BANK_QR_IMAGE_URL=
BANK_QR_PAYLOAD=
BANK_WEBHOOK_SECRET=
PAYMENT_QR_EXPIRES_MINUTES=15

# URL do đối tác tài chính cấp khi tích hợp trả góp thực tế.
INSTALLMENT_MODE=internal_review
INSTALLMENT_PAYMENT_URL=
INSTALLMENT_TERMS=3,6,9,12
INSTALLMENT_DOWN_PAYMENT_PERCENT=30
INSTALLMENT_ANNUAL_RATE_PERCENT=0
INSTALLMENT_POLICY_NAME=Dự tính trả góp nội bộ

# Phí tạm tính theo khu vực. Khi có tài khoản hãng vận chuyển, thay bằng API báo giá thật.
SHIPPING_FEE_LOCAL=30000
SHIPPING_FEE_NEARBY=35000
SHIPPING_FEE_SOUTH=40000
SHIPPING_FEE_CENTRAL=45000
SHIPPING_FEE_NORTH=50000

# Mặc định tạo mã giao vận nội bộ TECH-YYYYMMDD-XXXXXX. Đổi thành ghn khi có API thật.
SHIPPING_PROVIDER=internal
GHN_API_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api/v2
GHN_TOKEN=
GHN_SHOP_ID=
GHN_SERVICE_TYPE_ID=
GHN_DEFAULT_WEIGHT_GRAMS=
GHN_DEFAULT_LENGTH_CM=
GHN_DEFAULT_WIDTH_CM=
GHN_DEFAULT_HEIGHT_CM=

# Optional payment sandbox configuration.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_CREATE_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_STORE_ID=TechEcommerce

# Optional geocoder override. The default is https://photon.komoot.io.
GEOCODING_BASE_URL=https://photon.komoot.io
